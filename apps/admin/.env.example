# Tailfire Admin environment variables
# Copy this file to .env.local and replace placeholder values.

# API — browser-side base URL (relative, proxied via Next.js rewrites)
NEXT_PUBLIC_API_URL=/api/v1
# Server-side API origin (absolute URL for rewrites and server-side fetches)
API_ORIGIN=http://localhost:3101

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Optional Sentry client config
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
